{
  "name": "@chapaev17/eslint-config",
  "version": "0.1.0",
  "description": "Chapaev17's ESLint config",
  "keywords": [
    "eslint",
    "eslint-config",
    "prettier",
    "react",
    "security",
    "typescript",
    "vue"
  ],
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
