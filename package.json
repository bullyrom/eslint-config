  "devDependencies": {
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/eslint-plugin-security": "^3.0.1",
    "@types/node": "^25.2.1",
    "baseline-browser-mapping": "^2.9.19",
    "eslint": "^9.39.2",
    "eslint-plugin-package-json": "^0.88.2",
    "tsc": "^2.0.4",
    "tsup": "^8.5.1"
